# Jev classifies each completed conversation turn.
JEV_BEARER_KEY=replace-with-your-typesafe-bearer-key

# The writer maintains the topic summary. The evaluator inherits these settings.
WRITER_PROVIDER=openrouter
WRITER_MODEL=replace-with-a-model-that-supports-structured-output
# WRITER_API_KEY takes precedence over any provider-specific key inherited
# from the shell, host project, or Claude process.
WRITER_API_KEY=replace-with-your-writer-api-key

# Background hook runs can safely wait longer than the default 30 seconds.
WRITER_DEADLINE_MS=120000

# To use OpenAI or Anthropic, change WRITER_PROVIDER and WRITER_MODEL; the
# generic key above still applies. Alternatively, remove WRITER_API_KEY and
# provide OPENAI_API_KEY, ANTHROPIC_API_KEY, or OPENROUTER_API_KEY.
# See Configuration in README.md.
