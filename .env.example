# Jev classifies each completed conversation turn.
JEV_BEARER_KEY=replace-with-your-typesafe-bearer-key

# The writer maintains the topic summary. The evaluator inherits these settings.
WRITER_PROVIDER=openrouter
WRITER_MODEL=replace-with-a-model-that-supports-structured-output
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# Background hook runs can safely wait longer than the default 30 seconds.
WRITER_DEADLINE_MS=120000

# To use OpenAI or Anthropic instead, change WRITER_PROVIDER and provide
# OPENAI_API_KEY or ANTHROPIC_API_KEY. See Configuration in README.md.
